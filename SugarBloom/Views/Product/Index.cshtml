@model IEnumerable<CakeBake.Models.Product>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Products</h2>

        <a asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-circle"></i>

            Add Product

        </a>

    </div>

    <form id="filterForm"
          asp-action="Index"
          method="get"
          class="d-flex gap-3 mb-4">

        <select name="categoryId"
                class="form-select"
                style="max-width:250px"
                onchange="document.getElementById('filterForm').submit();">

            <option value="">All Categories</option>

            @foreach (var category in ViewBag.Categories)
            {
                if (ViewBag.SelectedCategory != null &&
                (int)ViewBag.SelectedCategory == category.Id)
                {
                    <option value="@category.Id" selected>
                        @category.Name
                    </option>
                }
                else
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }
            }

        </select>

        <select name="isAvailable"
                class="form-select"
                style="max-width:220px"
                onchange="document.getElementById('filterForm').submit();">

            @if (ViewBag.SelectedStatus == null)
            {
                <option value="" selected>All Status</option>
            }
            else
            {
                <option value="">All Status</option>
            }

            @if (ViewBag.SelectedStatus?.ToString() == "True")
            {
                <option value="true" selected>Available</option>
            }
            else
            {
                <option value="true">Available</option>
            }

            @if (ViewBag.SelectedStatus?.ToString() == "False")
            {
                <option value="false" selected>Unavailable</option>
            }
            else
            {
                <option value="false">Unavailable</option>
            }

        </select>

    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">

            @TempData["SuccessMessage"]

        </div>
    }

    <table class="table table-bordered table-hover align-middle">

        <thead>

            <tr>

                <th>Image</th>

                <th>Name</th>

                <th>Category</th>

                <th>Price</th>

                <th>Stock</th>

                <th>Status</th>

                <th width="180">Actions</th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td style="width:90px">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     width="70"
                                     height="70"
                                     class="rounded"
                                     style="object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Image
                                </span>
                            }

                        </td>

                        <td>@item.Name</td>

                        <td>@item.Category?.Name</td>

                        <td>@item.Price.ToString("0.00")</td>

                        <td>@item.StockQuantity</td>

                        <td>

                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Unavailable
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">

                                Edit

                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this product?')">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="7" class="text-center">

                        No products found.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
@{
    ViewData["Title"] = "Order Placed";
}

<div class="container text-center mt-5 mb-5">

    <i class="fas fa-check-circle text-success"
       style="font-size:80px;"></i>

    <h2 class="mt-4">
        Thank You!
    </h2>

    <p class="text-muted mt-3">
        Your order has been placed successfully.
    </p>

    <p class="text-muted">
        We're preparing your delicious desserts.
    </p>

    <div class="mt-4">

        <a asp-controller="Shop"
           asp-action="Index"
           class="boxed-btn me-3">

            Continue Shopping

        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="boxed-btn black">

            Back to Home

        </a>

    </div>

</div>
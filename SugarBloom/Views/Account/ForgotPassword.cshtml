@using CakeBake.ViewModels.Account
@model ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="text-center mb-5">

                    <h1 class="auth-title">
                        Forgot Password?
                    </h1>

                    <p class="auth-subtitle">
                        Enter your email to reset your password.
                    </p>

                </div>

                <div class="auth-card">

                    <div class="text-center mb-4">

                        <img src="~/assets/img/cakebake-logo.png"
                             class="login-logo"
                             alt="CakeBake Logo" />

                        <h3 class="mt-3">
                            Reset Password
                        </h3>

                    </div>

                    <form asp-action="ForgotPassword"
                          method="post">

                        <div asp-validation-summary="ModelOnly" class="validation-error mb-3"></div>

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email" class="validation-error"></span>

                        </div>

                        <button class="btn btn-register"
                                type="submit">

                            Send Verification Code

                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <a asp-action="Login">

                            Back to Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

@using CakeBake.ViewModels.Account
@model LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="text-center mb-5">

                    <h1 class="auth-title">
                        Welcome Back
                    </h1>

                    <p class="auth-subtitle">
                        Sign in to continue ordering your favorite cakes and desserts.
                    </p>

                </div>

                <div class="auth-card">

                    <div class="text-center mb-4">

                        <img src="~/assets/img/cakebake-logo.png"
                             class="login-logo"
							 alt="CakeBake Logo" />

                        <h3 class="mt-3">
                            Login
                        </h3>

                    </div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="validation-error mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="Email" class="form-label"></label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password" class="form-label"></label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="validation-error"></span>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                            </label>

                        </div>

                        <div class="text-end mb-3">

                            <a asp-controller="Account"
                               asp-action="ForgotPassword">
                                Forgot Password?
                            </a>

                        </div>

                        <button type="submit"
                                class="btn btn-register">
                            Login
                        </button>

                    </form>

                    <p class="text-center mt-4">

                        Don't have an account?

                        <a asp-controller="Account"
                           asp-action="Register">

                            Create one

                        </a>

                    </p>

                    <div class="text-center">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="back-home">

                            ← Back to Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
@using CakeBake.ViewModels.Account
@model ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="text-center mb-5">

                    <h1 class="auth-title">
                        Reset Password
                    </h1>

                    <p class="auth-subtitle">
                        Enter the verification code sent to your email and choose a new password.
                    </p>

                </div>

                <div class="auth-card">

                    <div class="text-center mb-4">

                        <img src="~/assets/img/cakebake-logo.png"
                             class="login-logo"
                             alt="CakeBake Logo" />

                        <h3 class="mt-3">
                            Create New Password
                        </h3>

                    </div>

                    <form asp-action="ResetPassword" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="validation-error mb-3">
                        </div>

                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">

                            <label asp-for="OTP" class="form-label">
                                Verification Code
                            </label>

                            <input asp-for="OTP"
                                   class="form-control"
                                   placeholder="Enter the 6-digit code" />

                            <span asp-validation-for="OTP"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label"></label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   placeholder="New Password" />

                            <span asp-validation-for="NewPassword"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label"></label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm Password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="validation-error"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-register">

                            Reset Password

                        </button>

                    </form>

                    <hr class="my-4" />

                    <form asp-action="ResendOtp" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="email"
                               value="@Model.Email" />

                        <input type="hidden"
                               name="returnAction"
                               value="ResetPassword" />

                        <button type="submit"
                                class="btn btn-outline-dark w-100">
                            Resend Verification Code
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
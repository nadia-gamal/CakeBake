@using CakeBake.ViewModels.Account
@model RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="text-center mb-5">

                    <h1 class="auth-title">
                        Welcome to Cake & Bake
                    </h1>

                    <p class="auth-subtitle">
                        Create your account and start ordering your favorite desserts.
                    </p>

                </div>

                <div class="auth-card">

                    <div class="text-center ">

                        <img src="~/assets/img/cakebake-logo.png" 
                             class="login-logo"
							 alt="CakeBake Logo" />

                        <h3 class="mt-3">
                            Create Account
                        </h3>

                    </div>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="validation-error mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="FullName" class="form-label"></label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email" class="form-label"></label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password" class="form-label"></label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="validation-error"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword" class="form-label"></label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm your password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="validation-error"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-register">
                            Create Account
                        </button>

                    </form>

                    <p class="text-center mt-4">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">

                            Sign In

                        </a>

                    </p>

                    <div class="text-center">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="back-home">

                            ← Back to Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
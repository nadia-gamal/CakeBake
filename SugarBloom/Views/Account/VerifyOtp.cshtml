@using CakeBake.ViewModels.Account
@model VerifyOtpViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify Email";
}

<section class="auth-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="text-center mb-5">

                    <h1 class="auth-title">
                        Verify Your Email
                    </h1>

                    <p class="auth-subtitle">
                        We've sent a 6-digit verification code to
                        <strong>@Model.Email</strong>
                    </p>

                </div>

                <div class="auth-card">

                    <div class="text-center mb-4">

                        <img src="~/assets/img/cakebake-logo.png"
                             class="login-logo"
                             alt="CakeBake Logo" />

                        <h3 class="mt-3">
                            Email Verification
                        </h3>

                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">

                            @TempData["Success"]

                        </div>
                    }

                    <form asp-action="VerifyOtp" method="post">

                        <input asp-for="Email" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="validation-error mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="OTP"
                                   class="form-label">

                                Verification Code

                            </label>

                            <input asp-for="OTP" type="hidden" id="OTP" />

                            <div class="otp-container">

                                <input type="text" maxlength="1" class="otp-input" />
                                <input type="text" maxlength="1" class="otp-input" />
                                <input type="text" maxlength="1" class="otp-input" />
                                <input type="text" maxlength="1" class="otp-input" />
                                <input type="text" maxlength="1" class="otp-input" />
                                <input type="text" maxlength="1" class="otp-input" />

                            </div>

                            <span asp-validation-for="OTP"
                                  class="validation-error"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-register">

                            Verify Email

                        </button>

                    </form>

                    <hr class="my-4" />

                    <form asp-action="ResendOtp" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="email"
                               value="@Model.Email" />

                        <input type="hidden"
                               name="returnAction"
                               value="VerifyOtp" />

                        <button type="submit"
                                class="btn btn-outline-dark w-100">
                            Resend Verification Code
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <a asp-action="Login">

                            Back to Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const inputs = document.querySelectorAll(".otp-input");
        const hiddenInput = document.getElementById("OTP");

        function updateOtp() {
            hiddenInput.value = [...inputs]
                .map(input => input.value)
                .join("");
        }

        inputs.forEach((input, index) => {

            input.addEventListener("input", function () {

                this.value = this.value.replace(/[^0-9]/g, "");

                updateOtp();

                if (this.value && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }

            });

            input.addEventListener("keydown", function (e) {

                if (e.key === "Backspace" && !this.value && index > 0) {
                    inputs[index - 1].focus();
                }

            });

            input.addEventListener("paste", function (e) {

                e.preventDefault();

                const data = (e.clipboardData || window.clipboardData)
                    .getData("text")
                    .replace(/\D/g, "")
                    .substring(0, 6);

                data.split("").forEach((char, i) => {
                    if (inputs[i]) {
                        inputs[i].value = char;
                    }
                });

                updateOtp();

                const nextIndex = Math.min(data.length, inputs.length - 1);
                inputs[nextIndex].focus();

            });

        });

    </script>
}
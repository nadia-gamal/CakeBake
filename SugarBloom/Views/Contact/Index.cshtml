@model CakeBake.ViewModels.ContactViewModel
	<!-- breadcrumb-section -->
	<div class="breadcrumb-section breadcrumb-bg">
		<div class="container">
			<div class="row">
				<div class="col-lg-8 offset-lg-2 text-center">
					<div class="breadcrumb-text">
					<p>We'd Love to Hear From You</p>
					<h1>Contact Us</h1>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end breadcrumb section -->
	<!-- contact form -->

	<div class="contact-from-section mt-150 mb-150">
		<div class="container">
		@if (TempData["Success"] != null)
		{
			<div class="alert alert-success">
				@TempData["Success"]
			</div>
		}
			<div class="row">
				<div class="col-lg-8 mb-5 mb-lg-0">
					<div class="form-title">
					<h2>Send Us a Message</h2>
					<p>
						Have a question, custom cake request, or feedback?
						Fill out the form below and our team will get back to you as soon as possible.
					</p>
					</div>
					<div id="form_status"></div>
					<div class="contact-form">
					<form asp-action="Index"
						  asp-controller="Contact"
						  method="post">

						@Html.AntiForgeryToken()
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

							<p>
							<input asp-for="Name" placeholder="Name">
							<span asp-validation-for="Name" class="text-danger"></span>

							<input asp-for="Email" placeholder="Email">
							<span asp-validation-for="Email" class="text-danger"></span>
							</p>

							<p>
							<input asp-for="Phone" placeholder="Phone">
							<span asp-validation-for="Phone" class="text-danger"></span>

							<input asp-for="Subject" placeholder="Subject">
							<span asp-validation-for="Subject" class="text-danger"></span>
							</p>
						<p>
							<textarea asp-for="Message"
									  cols="30"
									  rows="10"
									  placeholder="Message"></textarea>

							<span asp-validation-for="Message" class="text-danger"></span>
						</p>
						<p>
							<button type="submit" class="boxed-btn">
								Send Message
							</button>
						</p>
						</form>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="contact-form-wrap">
						<div class="contact-form-box">
							<h4><i class="fas fa-map"></i> Shop Address</h4>
						<p>Cairo, Egypt</p>
						</div>
						<div class="contact-form-box">
							<h4><i class="far fa-clock"></i> Shop Hours</h4>
						<p>Monday - Friday: 9:00 AM - 9:00 PM <br>Saturday - Sunday: 10:00 AM - 10:00 PM </p>
						</div>
						<div class="contact-form-box">
							<h4><i class="fas fa-address-book"></i> Contact</h4>
							<p>Phone: +00 111 222 3333 <br> Email: support@CakeBake.com</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end contact form -->
@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
}
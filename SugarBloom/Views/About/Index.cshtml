@{
	Layout = "_Layout";
	ViewData["Title"] = "About";
}
	
<!-- breadcrumb-section -->
	<div class="breadcrumb-section breadcrumb-bg">
		<div class="container">
			<div class="row">
				<div class="col-lg-8 offset-lg-2 text-center">
					<div class="breadcrumb-text">
					<p>Freshly Baked with Love</p>
					<h1>About Us</h1>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end breadcrumb section -->
<div class="about-intro text-center mb-5">

	<h2>Our Story</h2>

	<p>
		At CakeBake, we believe every celebration deserves something sweet.
		We create freshly baked cakes, cookies, cupcakes, and desserts using
		premium ingredients and handcrafted recipes to bring happiness to every bite.
	</p>

</div>
	<!-- featured section -->
	<div class="feature-bg">
		<div class="container">
			<div class="row">
				<div class="col-lg-7">
					<div class="featured-text">
					<h2 class="pb-3">
						Why Choose <span class="orange-text">CakeBake?</span>
					</h2>
						<div class="row">
							<div class="col-lg-6 col-md-6 mb-4 mb-md-5">
								<div class="list-box d-flex">
									<div class="list-icon">
										<i class="fas fa-shipping-fast"></i>
									</div>
									<div class="content">
										<h3>Home Delivery</h3>
									<p>Fast and reliable delivery to bring your favorite desserts fresh to your doorstep.</p>
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-6 mb-5 mb-md-5">
								<div class="list-box d-flex">
									<div class="list-icon">
										<i class="fas fa-medal"></i>
									</div>
									<div class="content">
									<h3>Premium Quality</h3>
									<p>Made with the finest ingredients to deliver exceptional taste in every bite.</p>
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-6 mb-5 mb-md-5">
								<div class="list-box d-flex">
									<div class="list-icon">
										<i class="fas fa-gift"></i>
									</div>
									<div class="content">
									<h3>Gift Boxes</h3>
									<p>Elegant dessert boxes perfect for gifts and celebrations.</p>
									</div>
								</div>
							</div>
							<div class="col-lg-6 col-md-6">
								<div class="list-box d-flex">
									<div class="list-icon">
										<i class="fas fa-heart"></i>
									</div>
									<div class="content">
									<h3>Made with Love</h3>
									<p>Every dessert is handcrafted with care and passion.</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end featured section -->
	<!-- shop banner -->
	<section class="shop-banner">
		<div class="container">
		<h3>
			Freshly Baked
			<br>
			<span class="orange-text">Every Day</span>
		</h3>

		<p class="mt-3">
			Explore our delicious collection of cakes, cupcakes,
			cookies, and desserts prepared fresh every day.
		</p>

		<a asp-controller="Shop"
		   asp-action="Index"
		   class="cart-btn btn-lg">
			Shop Now
		</a>
		</div>
	</section>
	


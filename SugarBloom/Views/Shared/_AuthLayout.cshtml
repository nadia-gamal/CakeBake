<!doctype html>
<html lang="en">
<head>

    <title>@ViewData["Title"] - CakeBake</title>
    <!-- favicon -->
    <link rel="shortcut icon" type="image/png" href="~/assets/img/logo1.png" />

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <link rel="stylesheet" href="~/Auth/css/bootstrap.min.css">
    <link rel="stylesheet" asp-append-version="true" href="~/Auth/css/style.css" />

</head>

<body>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/Login/js/jquery.min.js"></script>
    <script src="~/Login/js/popper.js"></script>
    <script src="~/Login/js/bootstrap.min.js"></script>
    <script src="~/Login/js/main.js"></script>

</body>
</html>
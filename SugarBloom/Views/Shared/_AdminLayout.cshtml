@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@ViewData["Title"] - CakeBake Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
	<link href="~/admin/css/styles.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/admin/css/custom.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body class="sb-nav-fixed">
    @inject Microsoft.AspNetCore.Identity.UserManager<CakeBake.Models.ApplicationUser> UserManager
    @inject CakeBake.Data.ApplicationDbContext Context

    @{
        var currentUser = await UserManager.GetUserAsync(User);

        var firstName = currentUser?.FullName.Split(' ').FirstOrDefault();
        var pendingOrders = Context.Orders.Count(x => x.Status == CakeBake.Enums.OrderStatus.Pending);
        var latestOrders = Context.Orders
        .Include(x => x.ApplicationUser)
        .OrderByDescending(x => x.OrderDate)
        .Take(5)
        .ToList();
    }
    <nav class="sb-topnav custom-navbar">

        <div class="navbar-left">

            <button class="btn" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>

            <h2>Welcome @firstName!</h2>

        </div>

        <div class="navbar-right">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get"
                  class="search-box">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Search products..." />

                <button type="submit" class="border-0 bg-transparent">
                    <i class="fas fa-search"></i>
                </button>

            </form>

            <div class="dropdown">

                <button class="icon-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <i class="fas fa-gear"></i>

                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow">

                    <li>
                        <a class="dropdown-item"
                           asp-controller="Settings"
                           asp-action="Profile">

                            <i class="fas fa-user me-2"></i>
                            My Profile

                        </a>
                    </li>

                </ul>

            </div>

            <div class="dropdown">

                <button class="icon-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <i class="far fa-bell"></i>

                    @if (pendingOrders > 0)
                    {
                        <span class="notification-dot"></span>
                    }

                </button>

                <div class="dropdown-menu dropdown-menu-end notification-menu shadow">

                    <h6 class="dropdown-header">
                        Notifications
                    </h6>

                    <div id="notificationContainer">

                        @if (latestOrders.Any())
                        {
                            foreach (var order in latestOrders)
                            {
                                <a asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="dropdown-item notification-item">

                                    <div class="d-flex align-items-center">

                                        <img src="@(string.IsNullOrEmpty(order.ApplicationUser?.ImageUrl)
                                                                             ? Url.Content("~/images/admin.png")
                                                                             : order.ApplicationUser.ImageUrl)"
                                     class="rounded-circle me-2"
                                     width="45"
                                     height="45"
                                     style="object-fit:cover;" />

                                        <div>

                                            <strong>
                                                @order.ApplicationUser?.FullName
                                            </strong>

                                            <div class="small text-muted">
                                                Placed a new order
                                            </div>

                                            <small class="text-secondary">
                                                @order.OrderDate.ToString("dd MMM - hh:mm tt")
                                            </small>

                                        </div>

                                    </div>

                                </a>
                                                }
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted">

                                No notifications.

                            </div>
                        }

                    </div>

                    <div class="dropdown-divider"></div>

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="dropdown-item text-center fw-bold">

                        View All

                    </a>

                </div>

            </div>

        </div>

    </nav>

    <!--sidebar-->
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <!-- Admin Profile -->

                    <div class="sidebar-profile">

                        <div class="profile-image">

                            <img src="@(string.IsNullOrEmpty(currentUser?.ImageUrl)
                                                  ? Url.Content("~/images/admin.png")
                                                  : currentUser.ImageUrl)"
                                 alt="Admin">

                        </div>

                        <h5>@currentUser?.FullName</h5>

                        <p>@currentUser?.Email</p>

                    </div>
                    <div class="nav">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")"
                           asp-controller="Admin"
                           asp-action="Index">

                            <i class="fas fa-th-large"></i>
                            <span>Dashboard</span>

                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")"
                           asp-controller="Category"
                           asp-action="Index">

                            <i class="fas fa-tags"></i>

                            <span>Categories</span>

                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")"
                           asp-controller="Product"
                           asp-action="Index">

                            <i class="fas fa-birthday-cake"></i>

                            <span>Products</span>

                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")"
                           asp-controller="Order"
                           asp-action="Index">

                            <i class="fas fa-shopping-cart"></i>

                            <span>Orders</span>

                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")"
                           asp-controller="Customer"
                           asp-action="Index">

                            <i class="fas fa-users"></i>

                            <span>Customers</span>

                        </a>
                            
                           
                        </div>
                    <div class="logout">

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button class="btn p-0 text-start text-white border-0 bg-transparent">

                                <i class="fas fa-power-off me-2"></i>

                                Logout

                            </button>
                        </form>
                    </div>
                </div>
            </nav>




        </div>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">

                    @RenderBody()

                </div>
			</main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/admin/js/scripts.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>


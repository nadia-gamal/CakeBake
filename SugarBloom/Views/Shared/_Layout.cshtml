@using CakeBake.Models
@using Microsoft.AspNetCore.Identity
@using CakeBake.Interfaces
@inject ICartService CartService
@inject UserManager<ApplicationUser> UserManager
@{
	var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="Responsive Bootstrap4 Shop Template, Created by Imran Hossain from https://imransdesign.com/">

	<!-- title -->
	<title>Cake & Bake</title>

	<!-- favicon -->
	<link rel="shortcut icon" type="image/png" href="~/assets/img/cakebake-logo.png"  />
	<!-- google font -->
	<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,700" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css?family=Poppins:400,700&display=swap" rel="stylesheet">
	<!-- fontawesome -->
	<link rel="stylesheet" href="~/assets/css/all.min.css">
	<!-- bootstrap -->
	<link rel="stylesheet" href="~/assets/bootstrap/css/bootstrap.min.css">
	<!-- owl carousel -->
	<link rel="stylesheet" href="~/assets/css/owl.carousel.css">
	<!-- magnific popup -->
	<link rel="stylesheet" href="~/assets/css/magnific-popup.css">
	<!-- animate css -->
	<link rel="stylesheet" href="~/assets/css/animate.css">
	<!-- mean menu css -->
	<link rel="stylesheet" href="~/assets/css/meanmenu.min.css">
	<!-- main style -->
	<link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true" />
	<!-- responsive -->
	<link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true" />

</head>
@{
	    ApplicationUser? currentUser = null;
	    string firstName = "";
			int cartCount = 0;

	    if (User.Identity != null && User.Identity.IsAuthenticated)
	    {
		        currentUser = await UserManager.GetUserAsync(User);
				cartCount = await CartService.GetCartCountAsync(currentUser!.Id);

		        if (!string.IsNullOrWhiteSpace(currentUser.FullName))
		        {
			            firstName = currentUser.FullName.Split(' ')[0];
		        }
	    }
}
<body>

	<!--PreLoader-->
	<div class="loader">
		<div class="loader-inner">
			<div class="circle"></div>
		</div>
	</div>
	<!--PreLoader Ends-->
	<!-- header -->
	<div class="top-header-area" id="sticker">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-12 col-sm-12 text-center">
					<div class="main-menu-wrap">
						<!-- logo -->
						<div class="site-logo">
							<a asp-controller="Home" asp-action="Index">
								<img src="~/assets/img/cakebake-logo.png"  />
							</a>
						</div>
						<!-- logo -->
						<!-- menu start -->
						<nav class="main-menu">
							<ul>
								
								<li class="@(controller == "Home" ? "current-list-item" : "")">
									<a asp-controller="Home" asp-action="Index">Home</a>
								</li>

								<li class="@(controller == "About" ? "current-list-item" : "")">
									<a asp-controller="About" asp-action="Index">About</a>
								</li>
								
								@if (User.Identity != null && User.Identity.IsAuthenticated)
								 {
									<li>
										<a href="#">
											👋 Hi, @firstName
										</a>

										<ul class="sub-menu user-sub-menu">

											<li class="user-info">
												<span>Hello, @firstName 👋</span>
												<small>@currentUser?.Email</small>
											</li>

											<li class="menu-divider"></li>

											<li>
												<a asp-controller="Profile"
												   asp-action="Index">

													<i class="fas fa-user"></i>
													My Profile

												</a>
											</li>

											<li>
												<a asp-controller="Order"
													asp-action="MyOrders">
													My Orders
												</a>
											</li>

											<li class="menu-divider"></li>

											<li>

												<form asp-controller="Account"
													  asp-action="Logout"
													  method="post">

													<button type="submit"
															class="submenu-logout">

														<i class="fas fa-sign-out-alt"></i>
														Logout

													</button>

												</form>

											</li>

										</ul>

									</li>
								 }
								else
								 {
									<li>
										<a asp-controller="Account"
										   asp-action="Login">
											Login
										</a>
									</li>

									<li>
										<a asp-controller="Account"
										   asp-action="Register">
											Register
										</a>
									</li>
								 }
								<li>
									<div class="header-icons">
										<a asp-controller="Cart"
										   asp-action="Index"
										   class="shopping-cart @(controller == "Cart" ? "active-cart" : "")"
										   style="position:relative;">

											<i class="fas fa-shopping-cart"></i>

											<span id="cart-count"
												  style="
        position:absolute;
        top:-8px;
        right:-10px;
        background:#499A13;
        color:white;
        border-radius:50%;
        min-width:20px;
        height:20px;
        line-height:20px;
        text-align:center;
        font-size:12px;
        font-weight:bold;
        display:@(cartCount > 0 ? "inline-block" : "none");">

												@cartCount

											</span>

										</a>
										<a class="mobile-hide search-bar-icon" href="#"><i class="fas fa-search"></i></a>
									</div>
								</li>
							</ul>
						</nav>
						<a class="mobile-show search-bar-icon" href="#"><i class="fas fa-search"></i></a>
						<div class="mobile-menu"></div>
						<!-- menu end -->
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end header -->
	<!-- search area -->
	<div class="search-area">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<span class="close-btn"><i class="fas fa-window-close"></i></span>
					<div class="search-bar">
						<div class="search-bar-tablecell">
							<h3>Search For:</h3>
							<form asp-controller="Shop" asp-action="Index" method="get">

								<input type="text"
									   name="search"
									   value="@Context.Request.Query["search"]"
									   placeholder="Find your sweet treat..." />

								<button type="submit">
									Search
									<i class="fas fa-search"></i>
								</button>

							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end search area -->

	@RenderBody()


	<!-- footer -->
	<div class="footer-area">
		<div class="container">
			<div class="row">

				<div class="col-lg-4 col-md-6">
					<div class="footer-box about-widget">
						<h2 class="widget-title">CakeBake</h2>

						<p>
							CakeBake is your destination for freshly baked cakes,
							cookies, cupcakes, and handcrafted desserts.
							We create sweet moments with premium ingredients and
							homemade recipes.
						</p>

					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="footer-box get-in-touch">

						<h2 class="widget-title">Contact Us</h2>

						<ul>
							<li>Cairo, Egypt</li>
							<li>support@cakebake.com</li>
							<li>+20 10 1234 5678</li>
						</ul>

					</div>
				</div>

				<div class="col-lg-4 col-md-12">
					<div class="footer-box">

						<h2 class="widget-title">Business Hours</h2>

						<ul>
							<li>Monday - Friday: 9:00 AM - 10:00 PM</li>
							<li>Saturday: 10:00 AM - 11:00 PM</li>
							<li>Sunday: 10:00 AM - 8:00 PM</li>
						</ul>

					</div>
				</div>

			</div>
		</div>
	</div>
	<!-- end footer -->
	<!-- copyright -->
	<!-- copyright -->
	<div class="copyright">
		<div class="container">
			<div class="row">
				<div class="col-lg-6 col-md-12">
					<p>
						&copy; @DateTime.Now.Year CakeBake.
						Freshly baked with love.
					</p>
				</div>

				<div class="col-lg-6 text-right col-md-12">
					<div class="social-icons">
						<ul>
							<li><a href="#"><i class="fab fa-facebook-f"></i></a></li>
							<li><a href="#"><i class="fab fa-instagram"></i></a></li>
							<li><a href="#"><i class="fab fa-linkedin-in"></i></a></li>
							<li><a href="#"><i class="fab fa-whatsapp"></i></a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end copyright -->
	<!-- end copyright -->

	<!-- jquery -->
	<script src="~/assets/js/jquery-1.11.3.min.js"></script>
	<!-- bootstrap -->
	<script src="~/assets/bootstrap/js/bootstrap.min.js"></script>
	<!-- count down -->
	<script src="~/assets/js/jquery.countdown.js"></script>
	<!-- isotope -->
	<script src="~/assets/js/jquery.isotope-3.0.6.min.js"></script>
	<!-- waypoints -->
	<script src="~/assets/js/waypoints.js"></script>
	<!-- owl carousel -->
	<script src="~/assets/js/owl.carousel.min.js"></script>
	<!-- magnific popup -->
	<script src="~/assets/js/jquery.magnific-popup.min.js"></script>
	<!-- mean menu -->
	<script src="~/assets/js/jquery.meanmenu.min.js"></script>
	<!-- sticker js -->
	<script src="~/assets/js/sticker.js"></script>
	<!-- main js -->
	<script src="~/assets/js/main.js"></script>

	<script>
		window.isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
	</script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
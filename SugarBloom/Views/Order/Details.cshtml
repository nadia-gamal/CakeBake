@model CakeBake.Models.Order

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Order Details";
}

<h2 class="mb-4">
    Order #@Model.Id
</h2>

<div class="card p-4">

    <p><strong>Customer :</strong> @Model.ApplicationUser?.FullName</p>

    <p><strong>Email :</strong> @Model.ApplicationUser?.Email</p>

    <p><strong>Date :</strong> @Model.OrderDate</p>

    <p><strong>Status :</strong> @Model.Status</p>

    <p><strong>Address :</strong> @Model.DeliveryAddress</p>

    <p><strong>Total :</strong> @Model.TotalPrice.ToString("C")</p>

</div>

<table class="table mt-4">

    <thead>

        <tr>

            <th>Product</th>

            <th>Price</th>

            <th>Quantity</th>

            <th>Total</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.OrderItems)
        {
            <tr>

                <td>@item.Product?.Name</td>

                <td>@item.UnitPrice</td>

                <td>@item.Quantity</td>

                <td>@(item.UnitPrice* item.Quantity)</td>

            </tr>
        }

    </tbody>

</table>

<a asp-controller="Notification"
   asp-action="Index"
   class="btn btn-secondary">

    Back

</a>